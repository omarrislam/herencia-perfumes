    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
